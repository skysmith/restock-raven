{% comment %}
  Restock Raven v1 widget snippet (duplicate theme only)
  - Kill switch: theme setting enable_restock_raven
  - Only renders when selected variant is unavailable
  - Posts to backend /api/restock/subscribe
{% endcomment %}

{% if settings.enable_restock_raven %}
  {% assign rr_dom_id = 'restock-raven-' | append: product.id %}
  <style>
    #{{ rr_dom_id }} {
      --rr-text: #333333;
      --rr-button-bg: #303030;
      --rr-button-text: #ffffff;
      --rr-border: #dedede;
      --rr-muted: #696969;
      --rr-focus: #f2a95d;
      --rr-font-body: var(--body-font, inherit);
      --rr-font-weight: var(--body-font-weight, 400);
      --rr-font-style: var(--body-font-style, normal);
      display: none;
      margin: 28px 0 0;
      padding: 24px 0 0;
      border-top: 1px solid var(--rr-border);
      background: transparent;
      color: var(--rr-text);
      font-family: var(--rr-font-body);
      font-weight: var(--rr-font-weight);
      font-style: var(--rr-font-style);
    }

    #{{ rr_dom_id }} .rr-title {
      margin: 0 0 14px;
      font-size: 16px;
      line-height: 1.45;
      font-weight: 700;
      font-family: var(--rr-font-body);
      letter-spacing: 0.01em;
    }

    #{{ rr_dom_id }} .rr-grid {
      display: grid;
      gap: 14px;
      grid-template-columns: 1fr;
      margin: 0;
    }

    #{{ rr_dom_id }} .rr-grid > input[type="email"] {
      width: 100%;
      min-height: 48px;
      border: 1px solid var(--rr-border);
      border-radius: 0;
      padding: 12px 14px;
      background: #fff;
      color: var(--rr-text);
      font-family: var(--rr-font-body);
      font-weight: var(--rr-font-weight);
      font-style: var(--rr-font-style);
      font-size: 14px;
      line-height: 1.4;
      box-shadow: none;
    }

    #{{ rr_dom_id }} .rr-grid > input[type="email"]::placeholder {
      color: #a5a5a5;
      opacity: 1;
    }

    #{{ rr_dom_id }} .rr-grid > label {
      display: flex;
      gap: 10px;
      align-items: center;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      font-size: 13px;
      line-height: 1.35;
      color: #3d3d3d;
      font-family: var(--rr-font-body);
      font-weight: var(--rr-font-weight);
      font-style: var(--rr-font-style);
    }

    #{{ rr_dom_id }} input[type="checkbox"] {
      flex: 0 0 auto;
      width: 14px;
      height: 14px;
      margin: 0;
      accent-color: var(--rr-button-bg);
    }

    #{{ rr_dom_id }} button[type="submit"] {
      width: 100%;
      min-height: 50px;
      border: 1px solid var(--rr-button-bg);
      border-radius: 0;
      background: var(--rr-button-bg);
      color: var(--rr-button-text);
      font-weight: 400;
      letter-spacing: 0.14em;
      font-family: var(--rr-font-body);
      font-size: 13px;
      text-transform: uppercase;
      cursor: pointer;
      transition: opacity 120ms ease, background-color 120ms ease, border-color 120ms ease;
      box-shadow: none;
    }

    #{{ rr_dom_id }} button[disabled] {
      opacity: 0.65;
      cursor: wait;
    }

    #{{ rr_dom_id }} button[type="submit"]:hover {
      opacity: 0.88;
    }

    #{{ rr_dom_id }} button[type="submit"]:focus-visible,
    #{{ rr_dom_id }} input:focus-visible {
      outline: 2px solid var(--rr-focus);
      outline-offset: 2px;
    }

    #{{ rr_dom_id }} .restock-raven-result {
      margin: 6px 0 0;
      font-size: 12px;
      color: var(--rr-muted);
      font-family: var(--rr-font-body);
      font-weight: var(--rr-font-weight);
      font-style: var(--rr-font-style);
    }

    #{{ rr_dom_id }} .restock-raven-result[data-state="success"] {
      color: #22603a;
    }

    #{{ rr_dom_id }} .restock-raven-result[data-state="error"] {
      color: #9f2f2f;
    }
  </style>
  <div id="{{ rr_dom_id }}" data-restock-raven data-product-id="{{ product.id }}">
    <p class="rr-title">Let me know when this is back in stock.</p>
    <form class="rr-grid" novalidate>
      <input type="email" name="email" placeholder="Email" aria-label="Email" autocomplete="email" />
      <label>
        <input type="checkbox" name="marketingOptIn" value="true" />
        Fill me in on sales and new product launches
      </label>
      <button type="submit">Sign Up</button>
      <p class="restock-raven-result"></p>
    </form>
  </div>

  <script>
    (function () {
      var root = document.getElementById('{{ rr_dom_id }}');
      if (!root) return;

      var variants = {{ product.variants | json }};
      var form = root.querySelector('form');
      var result = root.querySelector('.restock-raven-result');
      var submitButton = root.querySelector('button[type="submit"]');
      if (!form || !result || !submitButton || !variants || !variants.length) return;

      function byId(id) {
        for (var i = 0; i < variants.length; i++) {
          if (String(variants[i].id) === String(id)) return variants[i];
        }
        return null;
      }

      function getVariantFromDom() {
        var select = document.querySelector('form[action*="/cart/add"] [name="id"], form[action="/cart/add"] [name="id"], [data-product-options] [name="id"]');
        if (select && select.value) return byId(select.value);
        return byId('{{ product.selected_or_first_available_variant.id }}');
      }

      function updateVisibility() {
        var v = getVariantFromDom();
        if (!v) return;
        root.dataset.variantId = String(v.id);
        root.style.display = v.available ? 'none' : 'block';
      }

      document.addEventListener('variant:change', updateVisibility);
      document.addEventListener('change', function (e) {
        if (e.target && e.target.name === 'id') {
          updateVisibility();
        }
      });
      updateVisibility();

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        result.textContent = '';
        result.dataset.state = '';
        submitButton.disabled = true;
        var fd = new FormData(form);
        var payload = {
          email: fd.get('email') || null,
          marketingOptIn: fd.get('marketingOptIn') === 'true',
          productId: root.dataset.productId,
          variantId: root.dataset.variantId
        };

        var endpoint = window.restockRavenEndpoint || 'https://restock-raven.vercel.app/api/restock/subscribe';
        fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (res) {
            if (res.ok) {
              result.dataset.state = 'success';
              result.textContent = "Thanks. We'll email you when it's back.";
              form.reset();
              return null;
            }
            return res.json().catch(function () {
              return {};
            }).then(function (body) {
              result.dataset.state = 'error';
              result.textContent = body.error || 'Could not subscribe.';
            });
          })
          .catch(function () {
            result.dataset.state = 'error';
            result.textContent = 'Could not subscribe.';
          })
          .finally(function () {
            submitButton.disabled = false;
          });
      });
    })();
  </script>
{% endif %}
